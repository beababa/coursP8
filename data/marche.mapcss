/* Coloration iris et crossing + étiquette pour type de crossing
*/
area[boundary=administrative] {
    color: white;
    fill-color: white;
    fill-opacity: 0.5;
    fill-extent: 100;
    width: 12;
}
node[highway=crossing] {
    z-index: -100; 
    symbol-shape: circle; 
    symbol-size: +12; 
    symbol-fill-color:  tomato; 


    text: "crossing"; 
    text-anchor-horizontal: center; 
    text-anchor-vertical: center; 
    text-offset-x: -1; 
    text-offset-y: -1; 
}